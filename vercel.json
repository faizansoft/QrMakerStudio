{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.qr-generator.online"
        }
      ],
      "destination": "https://qr-generator.online/$1",
      "permanent": true
    },
    {
      "source": "/ar/bulk-qr-code-generator",
      "destination": "/bulk-qr-code-generator",
      "permanent": true
    },
    {
      "source": "/ar/qr-code-scanner",
      "destination": "/qr-code-scanner",
      "permanent": true
    },
    {
      "source": "/ar/social-media-qr-code",
      "destination": "/social-media-qr-code",
      "permanent": true
    },
    {
      "source": "/ar/pdf-qr-code-generator",
      "destination": "/pdf-qr-code-generator",
      "permanent": true
    },
    {
      "source": "/ar/app-store-qr-code-generator",
      "destination": "/app-store-qr-code-generator",
      "permanent": true
    },
    {
      "source": "/hi/bulk-qr-code-generator",
      "destination": "/bulk-qr-code-generator",
      "permanent": true
    },
    {
      "source": "/hi/qr-code-scanner",
      "destination": "/qr-code-scanner",
      "permanent": true
    },
    {
      "source": "/hi/social-media-qr-code",
      "destination": "/social-media-qr-code",
      "permanent": true
    },
    {
      "source": "/hi/pdf-qr-code-generator",
      "destination": "/pdf-qr-code-generator",
      "permanent": true
    },
    {
      "source": "/hi/app-store-qr-code-generator",
      "destination": "/app-store-qr-code-generator",
      "permanent": true
    },
    {
      "source": "/tr/bulk-qr-code-generator",
      "destination": "/bulk-qr-code-generator",
      "permanent": true
    },
    {
      "source": "/tr/qr-code-scanner",
      "destination": "/qr-code-scanner",
      "permanent": true
    },
    {
      "source": "/tr/social-media-qr-code",
      "destination": "/social-media-qr-code",
      "permanent": true
    },
    {
      "source": "/tr/pdf-qr-code-generator",
      "destination": "/pdf-qr-code-generator",
      "permanent": true
    },
    {
      "source": "/tr/app-store-qr-code-generator",
      "destination": "/app-store-qr-code-generator",
      "permanent": true
    },
    {
      "source": "/es/bulk-qr-code-generator",
      "destination": "/bulk-qr-code-generator",
      "permanent": true
    },
    {
      "source": "/es/qr-code-scanner",
      "destination": "/qr-code-scanner",
      "permanent": true
    },
    {
      "source": "/es/social-media-qr-code",
      "destination": "/social-media-qr-code",
      "permanent": true
    },
    {
      "source": "/es/pdf-qr-code-generator",
      "destination": "/pdf-qr-code-generator",
      "permanent": true
    },
    {
      "source": "/es/app-store-qr-code-generator",
      "destination": "/app-store-qr-code-generator",
      "permanent": true
    },
    {
      "source": "/vi/bulk-qr-code-generator",
      "destination": "/bulk-qr-code-generator",
      "permanent": true
    },
    {
      "source": "/vi/qr-code-scanner",
      "destination": "/qr-code-scanner",
      "permanent": true
    },
    {
      "source": "/vi/social-media-qr-code",
      "destination": "/social-media-qr-code",
      "permanent": true
    },
    {
      "source": "/vi/pdf-qr-code-generator",
      "destination": "/pdf-qr-code-generator",
      "permanent": true
    },
    {
      "source": "/vi/app-store-qr-code-generator",
      "destination": "/app-store-qr-code-generator",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/r/:shortCode*",
      "destination": "/r/index.html"
    },
    {
      "source": "/analytics/:linkId*",
      "destination": "/analytics/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/r/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/analytics/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
