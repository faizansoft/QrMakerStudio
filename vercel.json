{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.qr-generator.online"
        }
      ],
      "destination": "https://qr-generator.online/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/r/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/analytics/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/signup",
      "destination": "/index.html"
    },
    {
      "source": "/bulk-qr-code-generator",
      "destination": "/bulk-qr-code-generator/index.html"
    },
    {
      "source": "/qr-code-scanner",
      "destination": "/qr-code-scanner/index.html"
    },
    {
      "source": "/social-media-qr-code",
      "destination": "/social-media-qr-code/index.html"
    },
    {
      "source": "/((?!api|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}